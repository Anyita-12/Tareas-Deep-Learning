# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Datos: NO se suben (licencia de Kaggle y tamaño). Se versionan solo las huellas y el manifiesto.
data/*
!data/.gitkeep
!data/SHA256SUMS.txt
!data/manifest.json

# Prueba de humo (datos sintéticos y resultados)
data_smoke/
results_smoke/

# Resultados: se versionan JSON, CSV y figuras; las predicciones (.npy) pesan demasiado
results/**/*.npy
results/**/*.pkl
results/**/modelo_spark/
results/models/
results/**/*.tmp
results/logs/

# Spark y DuckDB
spark-warehouse/
metastore_db/
derby.log

# Jupyter Book
docs/_build/
_build/

# Sistema / editores
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
.idea/

# Secretos (por ejemplo, el token de Kaggle)
.env
kaggle.json
*.key

results_respaldo_*/
results/_respaldo_*/
*.zip
